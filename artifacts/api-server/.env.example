# ─── API Server — variables de entorno de ejemplo ────────────────────────────
# Copia este archivo a .env y ajusta los valores antes de iniciar el servidor.

# Puerto en el que escucha el servidor Express
PORT=8080

# Secreto para firmar las cookies de sesión — usa una cadena larga y aleatoria en producción
SESSION_SECRET=change-me-to-a-long-random-secret

# Ruta absoluta al archivo de base de datos SQLite.
# Si no se define, el script dev.mjs lo calcula automáticamente como:
#   <raíz del workspace>/lib/db/data/local.db
# SQLITE_DB_PATH=/ruta/absoluta/a/tu/proyecto/lib/db/data/local.db
