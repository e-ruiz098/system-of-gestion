# ─── API Server — example environment variables ───────────────────────────────
# Copy this file to .env and fill in your values before starting the server.
# The PORT value is managed by Replit automatically; set it manually for local dev.

# Port the Express server listens on
PORT=8080

# Secret used to sign session cookies — use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-secret

# Absolute path to the SQLite database file
# In Replit this is set automatically in the dev script; change for local dev.
SQLITE_DB_PATH=/absolute/path/to/your/project/lib/db/data/local.db
