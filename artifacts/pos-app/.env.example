# ─── POS App (Vite) — example environment variables ──────────────────────────
# Copy this file to .env and fill in your values before starting the dev server.
# The PORT and BASE_PATH values are managed by Replit automatically.

# Port the Vite dev server listens on
PORT=5173

# Base path of the app (use "/" for local dev, or the Replit artifact path)
BASE_PATH=/

# Port where the API server (api-server) is running — used by the Vite dev proxy
# to forward /api/* requests to the backend during local development.
API_PORT=8080
