# ─── POS App (Vite) — variables de entorno de ejemplo ───────────────────────
# Copia este archivo a .env y ajusta los valores antes de iniciar el servidor.

# Puerto en el que escucha el servidor de desarrollo de Vite
PORT=5173

# Ruta base de la app (usa "/" para desarrollo local)
BASE_PATH=/

# Puerto del servidor API (api-server) — usado por el proxy de Vite
# para redirigir las peticiones /api/* al backend durante el desarrollo local.
API_PORT=8080
